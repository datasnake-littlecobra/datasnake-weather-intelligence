# DataSnake Weather Intelligence — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# PostgreSQL connection
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/weather_intelligence

# Individual connection params (used if DATABASE_URL not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=weather_intelligence
DB_USER=postgres
DB_PASSWORD=yourpassword

# NOAA API (free token — get one at https://www.ncdc.noaa.gov/cdo-web/token)
# Optional: the Access API works without a token for most endpoints
NOAA_API_TOKEN=your_noaa_token_here

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/ingestion.log
