# DataSnake Weather Intelligence — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ── Supabase (recommended) ──────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → Database
#
# Use DIRECT connection (port 5432) for running DDL/migrations:
DATABASE_URL=postgresql://postgres.YOURREF:YOURPASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
#
# Use POOLER connection (port 6543) for ingestion scripts (short-lived connections):
DATABASE_POOLER_URL=postgresql://postgres.YOURREF:YOURPASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
#
# Supabase project details (for Edge Functions / API, optional in Phase 1)
SUPABASE_URL=https://YOURREF.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Individual DB params (fallback if DATABASE_URL not set) ─────────────────
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.YOURREF
DB_PASSWORD=yourpassword

# ── NOAA API ─────────────────────────────────────────────────────────────────
# Free token — get one at https://www.ncdc.noaa.gov/cdo-web/token
# Optional: the NCEI Access API works without a token for most endpoints
NOAA_API_TOKEN=your_noaa_token_here

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/ingestion.log
